generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  PROVIDER
}

model User {
  id                        String   @id @default(cuid())
  name                      String
  email                     String   @unique
  password                  String
  role                      Role
  charityRegistrationNumber String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}
